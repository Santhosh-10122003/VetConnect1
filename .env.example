# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vetconnect
DB_USER=postgres
DB_PASSWORD=postgres

# Spring Boot Configuration (the host usually sets PORT itself)
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security
# REQUIRED in production (32+ characters, your own random value). The default below is for development only.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Payments (advance for vet appointments and pet-care bookings)
# PAYMENT_GATEWAY=simulated is the default: test buttons, no money moves.
# To use Razorpay: PAYMENT_GATEWAY=razorpay, add your keys from dashboard.razorpay.com (rzp_test_... first), and use INR.
PAYMENT_GATEWAY=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CARE_CURRENCY=USD
CARE_CURRENCY_SYMBOL=$
CLINIC_ADVANCE_PERCENT=50

# Production (see docs/DEPLOYMENT.md)
# SEED_DEMO_DATA=false          the default: no sample accounts. Set true only for a throwaway local database
# SEED_ADMIN_PHONE=+91 98765 43210
# SEED_ADMIN_PASSWORD=choose-a-strong-password
# UPLOADS_DIR=/data/uploads     put this on a persistent disk
# CORS_ALLOWED_ORIGINS=*        or your web origin(s), comma separated
# APP_ANDROID_URL=              download link used on the pet QR landing page

# Mobile App API Configuration
EXPO_PUBLIC_API_URL=http://localhost:8080/api
# When running on physical Android device or emulator with host machine:
# Android Emulator host address: http://10.0.2.2:8080/api
# Physical Device over LAN: http://<YOUR_LAN_IP>:8080/api
