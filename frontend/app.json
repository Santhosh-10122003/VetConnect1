{
  "expo": {
    "name": "VetConnect",
    "slug": "vetconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vetconnect.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VetConnect uses your location to show veterinarians near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A9D9F5"
      },
      "package": "com.vetconnect.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store"
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#A9D9F5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VetConnect uses your location to show veterinarians near you."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
