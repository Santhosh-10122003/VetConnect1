{
  "expo": {
    "name": "Jenni",
    "slug": "jenni",
    "scheme": "jenni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jenni.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Jenni uses your location to show veterinarians near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A9D9F5"
      },
      "package": "com.jenni.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store"
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#A9D9F5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jenni uses your location to show veterinarians near you."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Jenni uses your camera to scan a pet's QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jenni uses your photos so you can add a picture of your pet.",
          "cameraPermission": "Jenni uses your camera so you can take a picture of your pet."
        }
      ],
      "expo-sharing"
    ]
  }
}
